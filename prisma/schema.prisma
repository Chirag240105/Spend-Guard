generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Policy {
  id              String        @id @default(cuid())
  name            String
  naturalLanguage String
  compiledPolicy  Json
  version         Int           @default(1)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  auditLogs       AuditLog[]
  decisions       Decision[]
  transactions    Transaction[]
}

model Transaction {
  id        String     @id @default(cuid())
  amount    Float
  currency  String     @default("INR")
  merchant  String
  category  String
  timestamp DateTime   @default(now())
  agentId   String
  metadata  Json?
  policyId  String
  createdAt DateTime   @default(now())
  auditLogs AuditLog[]
  decision  Decision?
  policy    Policy     @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([policyId])
}

model Decision {
  id            String      @id @default(cuid())
  transactionId String      @unique
  policyId      String
  decision      String
  reason        String
  ruleResults   Json
  confidence    Float?
  source        String
  createdAt     DateTime    @default(now())
  policy        Policy      @relation(fields: [policyId], references: [id], onDelete: Cascade)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([policyId])
}

model AuditLog {
  id            String       @id @default(cuid())
  transactionId String?
  policyId      String?
  event         String
  actor         String
  details       Json?
  createdAt     DateTime     @default(now())
  policy        Policy?      @relation(fields: [policyId], references: [id])
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  @@index([policyId])
  @@index([transactionId])
}

model Merchant {
  id            String         @id @default(cuid())
  apiKeyHash    String         @unique
  webhookUrl    String?
  webhookSecret String?
  createdAt     DateTime       @default(now())
  orders        Order[]
  webhookEvents WebhookEvent[]
}

model Order {
  id             String    @id @default(cuid())
  merchantId     String
  amount         Decimal   @db.Decimal(18, 2)
  currency       String    @default("INR")
  status         String    @default("CREATED")
  createdAt      DateTime  @default(now())
  gatewayOrderId String?   @unique
  merchant       Merchant  @relation(fields: [merchantId], references: [id])
  payments       Payment[]

  @@index([merchantId, createdAt])
}

model Payment {
  id                 String              @id @default(cuid())
  orderId            String
  status             PaymentStatus       @default(CREATED)
  retryCount         Int                 @default(0)
  provider           String              @default("mock")
  failureReason      String?
  razorpayOrderId    String?             @unique
  razorpayPaymentId  String?             @unique
  razorpaySignature  String?
  checkoutStatus     String              @default("INITIALIZED")
  verifiedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  gatewayPaymentId   String?             @unique
  agentDecisions     AgentDecision[]
  ledgerTransactions LedgerTransaction[]
  order              Order               @relation(fields: [orderId], references: [id])
  attempts           PaymentAttempt[]

  @@index([orderId, status])
}

model PaymentAttempt {
  id               String         @id @default(cuid())
  paymentId        String
  attemptNumber    Int
  outcome          AttemptOutcome
  gatewayErrorCode String?
  createdAt        DateTime       @default(now())
  payment          Payment        @relation(fields: [paymentId], references: [id])

  @@unique([paymentId, attemptNumber])
}

model LedgerTransaction {
  id        String        @id @default(cuid())
  paymentId String?
  createdAt DateTime      @default(now())
  entries   LedgerEntry[]
  payment   Payment?      @relation(fields: [paymentId], references: [id])
}

model LedgerEntry {
  id                  String            @id @default(cuid())
  ledgerTransactionId String
  accountId           String
  type                LedgerEntryType
  amount              Decimal           @db.Decimal(18, 2)
  createdAt           DateTime          @default(now())
  account             LedgerAccount     @relation(fields: [accountId], references: [id])
  ledgerTransaction   LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id])

  @@index([ledgerTransactionId])
}

model LedgerAccount {
  id           String        @id @default(cuid())
  ownerType    String
  ownerId      String
  balanceCache Decimal       @default(0) @db.Decimal(18, 2)
  entries      LedgerEntry[]

  @@unique([ownerType, ownerId])
}

model IdempotencyKey {
  id           String   @id @default(cuid())
  key          String
  endpoint     String
  requestHash  String
  responseBody Json?
  status       String   @default("PROCESSING")
  createdAt    DateTime @default(now())

  @@unique([key, endpoint])
}

model OutboxEvent {
  id            String   @id @default(cuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  dispatched    Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([dispatched, createdAt])
}

model AgentDecision {
  id            String         @id @default(cuid())
  paymentId     String
  inputSnapshot Json
  output        Json
  policyAction  String
  createdAt     DateTime       @default(now())
  payment       Payment        @relation(fields: [paymentId], references: [id])
  approval      HumanApproval?

  @@index([paymentId, createdAt])
}

model HumanApproval {
  id              String         @id @default(cuid())
  agentDecisionId String         @unique
  status          ApprovalStatus @default(pending)
  reviewedBy      String?
  reviewedAt      DateTime?
  agentDecision   AgentDecision  @relation(fields: [agentDecisionId], references: [id])

  @@index([status])
}

model WebhookEvent {
  id             String         @id @default(cuid())
  merchantId     String
  eventType      String
  dedupeKey      String
  payload        Json
  deliveryStatus DeliveryStatus @default(pending)
  attempts       Int            @default(0)
  nextRetryAt    DateTime?
  createdAt      DateTime       @default(now())
  merchant       Merchant       @relation(fields: [merchantId], references: [id])

  @@unique([merchantId, dedupeKey])
  @@index([deliveryStatus, nextRetryAt])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("REVIEWER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Outbox {
  id          String    @id @default(cuid())
  eventType   String
  payload     Json
  aggregateId String
  status      String    @default("pending")
  retryCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
  @@index([eventType, status])
}

enum PaymentStatus {
  CREATED
  ATTEMPTED
  SUCCESS
  FAILED
  AI_DIAGNOSIS
  RECOVERY_PENDING
  RETRYING
  HUMAN_REVIEW
  APPROVED
  REJECTED
  DO_NOT_RETRY
}

enum AttemptOutcome {
  SUCCESS
  FAILED
}

enum LedgerEntryType {
  debit
  credit
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum DeliveryStatus {
  pending
  delivered
  failed
}
